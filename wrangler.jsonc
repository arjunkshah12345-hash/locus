{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "locus",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "BOARD", "class_name": "LeaseBoard" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LeaseBoard"] }]
}
