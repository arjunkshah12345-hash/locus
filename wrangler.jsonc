{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "locus",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "BOARD", "class_name": "LeaseBoard" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LeaseBoard"] }],
  "workflows": [
    {
      "name": "locus-referee",
      "binding": "REFEREE",
      "class_name": "RefereeWorkflow"
    }
  ],
  // Artifacts needs Workers Paid. After upgrading, uncomment both blocks,
  // run `npm run deploy`, then `npm run swarm -- --seed` once to create the canon.
  // "artifacts": [{ "binding": "ARTIFACTS", "namespace": "locus" }],
  // "vars": { "CANON_REPO": "canon" },
  "queues": {
    "producers": [{ "binding": "EVENTS", "queue": "locus-artifact-events" }],
    "consumers": [{ "queue": "locus-artifact-events", "max_batch_size": 10 }]
  }
}
